# Contexto de build de las imágenes (backend y frontend): solo código fuente y
# manifiestos. Las dependencias y los builds se generan dentro de la imagen.

# Repo, editores y herramientas
alternatives
.git
.github
.vscode
.idea
.claude
.nx

# Dependencias y salidas de build, typecheck y tests
**/node_modules
.pnpm-store
**/dist
apps/*/build
**/out-tsc
**/coverage
**/test-output
**/*.tsbuildinfo
tmp

# Código generado (se regenera en el build)
**/.react-router
db/*/generated

# Datos y secretos: los CSV se montan en runtime y los .env no entran a una imagen
data
**/.env
**/.env.*
!**/.env.example

# Python
**/__pycache__
**/*.py[cod]
**/.pytest_cache
**/.venv

# Sistema
**/.DS_Store
**/Thumbs.db
**/*.log
