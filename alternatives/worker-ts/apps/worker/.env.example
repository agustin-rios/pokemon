# Base de datos de la app (Postgres de docker compose).
DATABASE_URL=postgresql://postgres:postgres@localhost:5441/pokemon
# Redis de docker compose: la cola de corridas (BullMQ).
REDIS_URL=redis://localhost:6411
POKEAPI_URL=https://pokeapi.co/api/v2
# Pokémon 1..POKEMON_LIMIT (2 a 1025).
POKEMON_LIMIT=100
# Cuánto vale el lock de la corrida en Redis, en ms (se renueva solo mientras el worker vive).
# Default 30000; solo se cambia en pruebas.
# LOCK_DURATION_MS=30000
