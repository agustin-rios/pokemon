PORT=3000
# Base de datos de la app (Postgres de docker compose).
DATABASE_URL=postgresql://postgres:postgres@localhost:5441/pokemon
# Orígenes separados por coma; "*" refleja cualquiera (prohibido con NODE_ENV=production).
CORS_ALLOW_ORIGINS=*
# Redis de docker compose: la cola de corridas (BullMQ). Default: redis://localhost:6411.
REDIS_URL=redis://localhost:6411
