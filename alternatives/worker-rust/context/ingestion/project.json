{
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "name": "pokemon-context-ingestion",
  "projectType": "library",
  "sourceRoot": "context/ingestion/src",
  "tags": ["type:context", "scope:pokemon"],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "command": "cargo build -p pokemon-context-ingestion"
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "command": "cargo test -p pokemon-context-ingestion"
      }
    },
    "lint": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "commands": [
          "cargo clippy -p pokemon-context-ingestion --all-targets -- -D warnings",
          "cargo fmt -p pokemon-context-ingestion -- --check"
        ],
        "parallel": false
      }
    }
  }
}
