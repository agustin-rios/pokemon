# Variables del worker en desarrollo (`pnpm nx dev pokemon-worker`). Copia este
# archivo a `.env` (esta carpeta o la raíz); en producción (APP_ENV=production)
# no se lee ningún .env.
APP_ENV=development

# Postgres de docker compose (POSTGRES_PORT del .env de la raíz).
DATABASE_URL=postgresql://postgres:postgres@localhost:5451/pokemon

# PokeAPI y cuántos Pokémon se bajan (2..1025).
POKEAPI_URL=https://pokeapi.co/api/v2
POKEMON_LIMIT=100

# Opcionales: por defecto, host:pid:hex aleatorio, 30 s y 5 s.
# WORKER_ID=worker-1
# LEASE_SECONDS=30
# POLL_SECONDS=5
