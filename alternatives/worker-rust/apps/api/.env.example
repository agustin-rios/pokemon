# Variables de la API en desarrollo (`pnpm nx dev pokemon-api`). Copia este archivo
# a `.env` (esta carpeta o la raíz); en producción (APP_ENV=production) no se lee ningún .env.
APP_ENV=development
PORT=3000
# Base de datos de la app (Postgres de docker compose; POSTGRES_PORT del .env de la raíz).
DATABASE_URL=postgresql://postgres:postgres@localhost:5451/pokemon
# Orígenes separados por coma; "*" refleja cualquiera (prohibido con APP_ENV=production).
CORS_ALLOW_ORIGINS=*
