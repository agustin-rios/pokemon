# Variables de docker compose. Copiar a .env (no se versiona): cp .env.example .env
# Compose lee .env solo; si falta una variable, no arranca.
# Las claves van dentro de URLs: usar solo letras, números, - y _.
# Si cambias usuarios, claves o puertos, actualiza también DATABASE_URL en
# apps/api/.env y apps/worker/.env.

# Puerto de Postgres en el host
POSTGRES_PORT=5451

# Postgres: superusuario y base de la app. Se crean con el volumen: para cambiarlos
# después, docker compose down -v.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=pokemon

# Solo docker-compose.yml (API, worker y web en contenedores; docker-compose.base.yml no los usa)
WEB_PORT=8021
# Orígenes que la API acepta por CORS (en producción no admite "*"). La web llama
# a /api desde su mismo origen (nginx), así que basta con su URL.
API_CORS_ALLOW_ORIGINS=http://localhost:8021
