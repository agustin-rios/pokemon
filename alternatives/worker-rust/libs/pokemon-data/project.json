{
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "name": "pokemon-data",
  "projectType": "library",
  "sourceRoot": "libs/pokemon-data/src",
  "tags": ["type:lib", "scope:shared"],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "command": "cargo build -p pokemon-data"
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "command": "cargo test -p pokemon-data"
      }
    },
    "lint": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "commands": [
          "cargo clippy -p pokemon-data --all-targets -- -D warnings",
          "cargo fmt -p pokemon-data -- --check"
        ],
        "parallel": false
      }
    }
  }
}
