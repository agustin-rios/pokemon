# Variables de docker compose. Copiar a .env (no se versiona): cp .env.example .env
# Compose lee .env solo; si falta una variable, no arranca.
# Las claves van dentro de URLs, SQL y JSON: usar solo letras, números, - y _.
# Si cambias usuarios, claves o puertos, actualiza también DATABASE_URL en
# apps/api/.env y db/main/.env, y AIRFLOW_* en apps/api/.env.

# Puertos en el host
POSTGRES_PORT=5434
AIRFLOW_PORT=8080

# Postgres: superusuario y base de la app. Usuarios, claves y bases (también las
# de Airflow) se crean con el volumen: para cambiarlos después, docker compose down -v.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=pokemon

# Base interna de Airflow (mismo Postgres)
AIRFLOW_DB_USER=airflow
AIRFLOW_DB_PASSWORD=airflow
AIRFLOW_DB_NAME=airflow

# Usuario admin de la UI y la API REST de Airflow
AIRFLOW_ADMIN_USERNAME=airflow
AIRFLOW_ADMIN_PASSWORD=airflow
# Firma de los JWT de la API de Airflow
AIRFLOW_JWT_SECRET=airflow_jwt_secret
