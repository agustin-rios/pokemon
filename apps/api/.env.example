PORT=3000
# Base de datos de la app (Postgres de docker compose).
DATABASE_URL=postgresql://postgres:postgres@localhost:5434/pokemon
# Airflow (docker compose): POST /api/etl/runs dispara ahí el DAG de carga.
AIRFLOW_URL=http://localhost:8080
AIRFLOW_USERNAME=airflow
AIRFLOW_PASSWORD=airflow
# Orígenes separados por coma; "*" refleja cualquiera (prohibido con NODE_ENV=production).
CORS_ALLOW_ORIGINS=*
